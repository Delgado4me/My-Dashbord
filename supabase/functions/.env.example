# Copy to .env locally or set these names in Supabase Edge Function Secrets.
# HTTPS application origin; use the published Lovable app URL, not lovable.dev/projects/...
DASHBOARD_SITE_URL=https://your-dashboard.lovable.app
# Optional, comma-separated exact HTTPS preview origins. No wildcards.
DASHBOARD_ALLOWED_ORIGINS=
# UUID from Authentication -> Users in the EXISTING external Supabase project.
DASHBOARD_OWNER_USER_ID=
DASHBOARD_GOOGLE_EMAIL=
DASHBOARD_GOOGLE_CLIENT_ID=
DASHBOARD_GOOGLE_CLIENT_SECRET=
# Optional test source. Keep your existing private vault settings if continuing to use it.
DASHBOARD_OBSIDIAN_REPOSITORY=Delgado4me/My-Dashbord
DASHBOARD_OBSIDIAN_BRANCH=main
DASHBOARD_OBSIDIAN_PATH_PREFIX=notes
DASHBOARD_OBSIDIAN_GITHUB_TOKEN=
